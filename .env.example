# Database Configuration
MYSQL_USER=portal
MYSQL_PASSWORD=replace_with_secure_password
MYSQL_ROOT_PASSWORD=replace_with_secure_root_password

# JWT Security Configuration
JWT_SECRET=replace_with_random_jwt_secret_key_64_chars
JWT_EXPIRY=1h
JWT_COOKIE_MAX_AGE_MS=3600000

# Session Reset Secret
RESET_SESSION_SECRET=replace_with_secure_reset_secret

# Google OAuth Configuration (Optional if using Local Auth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost/auth/google/callback

# Frontend & CORS URLs
FRONTEND_URL=http://localhost
FRONTEND_URLS=http://localhost
